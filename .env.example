# Copy to .env (never commit .env)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here                # from https://aistudio.google.com/apikey
MODEL_NAME=gemini-2.5-flash-lite      # use ONE model for every experiment
LLM_RPM=10                            # stay under your free-tier requests/minute (check AI Studio)
GEMINI_THINKING_BUDGET=               # optional; 0 disables thinking on models that allow it

# Paid-tier prices used only to compute the *equivalent* cost. VERIFY on the Gemini pricing page and
# fill in the date. Actual spend on the free tier is 0.
PRICE_INPUT_PER_1M=0.10
PRICE_OUTPUT_PER_1M=0.40
PRICING_DATE_CHECKED=

SHOP_TODAY=2026-10-31                 # fixed 'today' for return-window rules, keeps results reproducible
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_AUTH_TOKEN=                       # set the same random string on BOTH services when deployed
MCP_HOST=127.0.0.1
MCP_PORT=8001
RATE_LIMIT_PER_MIN=10
ALLOW_EVAL_ENDPOINT=0
LOG_LEVEL=INFO
ENVIRONMENT=development
